# .env.example
ELEVEN_LABS_API_KEY=insert_api_key_here
# Optional ElevenLabs overrides (narrator voice and model)
# ELEVEN_LABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# ELEVEN_LABS_MODEL=eleven_multilingual_v2
PORT=5173
LOCAL_HOST_URL=http://localhost:5173


# Gemini grades the written theory on the final report (server-side only; never prefix with VITE_)
GEMINI_API_KEY=insert_api_key_here
# Optional overrides
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# --- Connecting the website to the real backend (FastAPI) ---
# Leave both empty to use the built-in dev mock (needs server/private/case-private.json).
# Dev: proxy /api to your backend. No CORS setup needed, and the mock is switched off.
# API_PROXY_TARGET=http://localhost:8000
# Deployed site: call the backend directly (the backend must allow the site's origin with CORS).
# VITE_API_URL=https://api.example.com
