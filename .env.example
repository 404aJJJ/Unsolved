# .env.example
ELEVEN_LABS_API_KEY=insert_api_key_here
# Optional ElevenLabs overrides. Each character's voice ID is in server/voices.json; override one with ELEVEN_LABS_VOICE_<SPEAKER>, e.g. ELEVEN_LABS_VOICE_MW
# ELEVEN_LABS_MODEL=eleven_multilingual_v2
PORT=5173
LOCAL_HOST_URL=http://localhost:5173


# --- Vercel only (leave unset to keep the local SQLite file) ---
# Neon Free plan, pooled connection string. Create the project at neon.tech, not the Vercel Marketplace.
# DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require
# Whole contents of server/private/case-private.json, one line. The file itself is not deployed.
# UNSOLVED_CASE_JSON=

# --- Connecting the website to the real backend (FastAPI) ---
# Leave both empty to use the built-in dev mock (needs server/private/case-private.json).
# Dev: proxy /api to your backend. No CORS setup needed, and the mock is switched off.
# API_PROXY_TARGET=http://localhost:8000
# Deployed site: call the backend directly (the backend must allow the site's origin with CORS).
# VITE_API_URL=https://api.example.com
